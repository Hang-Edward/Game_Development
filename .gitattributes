# GLB 模型文件（Git LFS）
*.glb filter=lfs diff=lfs merge=lfs -text

# FBX 模型文件（Git LFS）
*.fbx filter=lfs diff=lfs merge=lfs -text

# Unity 场景和预制体（文本格式可合并）
*.unity text=auto
*.prefab text=auto

# Unity Animator Controller
*.controller text=auto

# C# 脚本
*.cs text=auto diff=csharp

# 着色器
*.shader text=auto
*.hlsl text=auto
*.cginc text=auto

# 文本资源
*.json text=auto
*.xml text=auto
*.txt text=auto
*.md text=auto
*.asset text=auto
*.meta text=auto

# 图片资源（不进行 diff）
*.png -text diff=image

# Unity Library 不计入语言统计
MagicShard_Unity/Library/* linguist-vendored
